{
  "name": "k-chat",
  "version": "0.1.0",
  "description": "A slimmed-down chat app you host yourself on Firebase's free Spark plan: Angular, Authentication, Cloud Firestore and Hosting.",
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "ng": "ng",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/check-config.mjs && ng serve",
    "dev": "node scripts/emulators.mjs dev",
    "emulators": "node scripts/emulators.mjs start",
    "build": "node scripts/check-config.mjs && ng build",
    "test": "ng test --watch=false && node --test \"scripts/**/*.test.mjs\"",
    "test:rules": "node scripts/sync-limits.mjs --check && node scripts/emulators.mjs rules-test",
    "lint": "eslint . && tsc -p firestore/tsconfig.json && prettier --check . && node scripts/sync-limits.mjs --check && node scripts/emoji-data.mjs --check",
    "format": "prettier --write .",
    "limits": "node scripts/sync-limits.mjs",
    "emoji-data": "node scripts/emoji-data.mjs",
    "deploy": "node scripts/check-config.mjs --deploy && ng build && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "deploy:hosting": "node scripts/check-config.mjs --deploy && ng build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "firebase": "13.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "24.19.1",
    "angular-eslint": "22.5.0",
    "emojibase-data": "17.0.0",
    "eslint": "10.12.0",
    "firebase-tools": "15.33.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
